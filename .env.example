# Optional server overrides. Normal setup happens in the owner Connections screen.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
OPENAI_MODEL=gpt-4o-mini
# For advanced/headless deployments only; never commit a real .env.
# OPENAI_API_KEY=
# SLACK_WEBHOOK_URL=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB=Requests
# LIVE_DELIVERY=false

# Optional local external intake form (npm run intake), after publishing n8n.
# This is the separate caller secret configured on n8n's Receive request node.
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/flowdesk-triage
# N8N_WEBHOOK_SECRET=
# INTAKE_PORT=3001
