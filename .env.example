# Node.js 24+; no npm dependencies required.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# demo is explicitly deterministic, NOT an LLM. Choose live to use OpenAI.
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# All API endpoints require this token if set. REQUIRED for non-loopback hosting.
APP_TOKEN=
# External delivery requires BOTH this flag and each integration's credentials.
LIVE_DELIVERY=false
SLACK_WEBHOOK_URL=
# Google service account email + PEM private key. Share the Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Requests
