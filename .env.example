# Node.js 24+; no npm dependencies required.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Create accounts in the browser. Password hashes and the session signing secret are stored in data/.
# Classification requires an OpenAI API key; sign-up and the workspace can open without one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional n8n machine credential (24+ chars recommended). Set the registered account it should use.
APP_TOKEN=
WEBHOOK_OWNER_EMAIL=
# External delivery requires BOTH this flag and each integration's credentials.
LIVE_DELIVERY=false
SLACK_WEBHOOK_URL=
# Google service account email + PEM private key. Share the Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Requests
