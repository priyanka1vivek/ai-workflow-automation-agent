# Node.js 24+; no npm dependencies required.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# One workspace owner. Choose a unique password (12+ chars) and random secret (32+ chars).
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=
# The real AI workflow needs an OpenAI API key. Classification cannot run without one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Machine credential for n8n and external webhooks. Required (24+ chars) for non-loopback hosting.
APP_TOKEN=
# External delivery requires BOTH this flag and each integration's credentials.
LIVE_DELIVERY=false
SLACK_WEBHOOK_URL=
# Google service account email + PEM private key. Share the Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Requests
